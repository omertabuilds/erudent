# Copy this file to .env.local and fill in the values.
# Ask Eliam for the dev values. Never commit .env.local.

# Supabase project URL and public anon key (Supabase dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# SERVER-ONLY SECRETS. Only Eliam needs these, for the question importer.
# Never prefix with NEXT_PUBLIC_, never add to Vercel, never paste in Discord.
# ---------------------------------------------------------------------
# Supabase dashboard → Project Settings → API keys → secret / service_role
SUPABASE_SERVICE_ROLE_KEY=
# notion.so/profile/integrations → new internal integration → share the Question Bank with it
NOTION_TOKEN=
